{
  "expo": {
    "name": "FuelWise",
    "slug": "fuelwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuelwise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.fuelwise.app"
    },
    "android": {
      "package": "za.co.fuelwise.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#185FA5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "FuelWise",
      "shortName": "FuelWise",
      "themeColor": "#185FA5",
      "description": "Fuel prices, nearby stations and fill-up tracking for South African motorists."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FuelWise to use your location to find nearby fuel stations."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#185FA5",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0D2E52"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fuelwise-sa"
      }
    }
  }
}
