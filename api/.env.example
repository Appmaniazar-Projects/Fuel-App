# FillUp API — copy to .env and fill in. Never commit .env.

# Skip API-key auth during local development
FILLUP_DEV_MODE=true

# Production auth: comma-separated keys, or a single master key
FILLUP_API_KEYS=
# FILLUP_MASTER_KEY=

# Supabase (service role key is server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
